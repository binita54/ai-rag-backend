# Application
APP_NAME=Palm Mind AI RAG Backend
APP_DEBUG=false
MAX_UPLOAD_SIZE=26214400

# SQLite metadata database
DATABASE_URL=sqlite+aiosqlite:///./data/ai_rag.db

# Qdrant vector store (mode: "local" or "server")
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=documents
QDRANT_LOCAL_PATH=./data/qdrant

# Redis chat memory
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400
REDIS_MAX_HISTORY=50

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# LLM provider (openai_compatible works with OpenAI, Ollama /v1, Groq, and others)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
